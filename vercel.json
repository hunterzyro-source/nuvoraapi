{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "public",
  "functions": {
    "api/[...route].js": {
      "maxDuration": 300
    },
    "api/messages/[channel].js": {
      "maxDuration": 300
    },
    "api/members/[name].js": {
      "maxDuration": 300
    },
    "api/rtc/ice-servers.js": {
      "maxDuration": 60
    },
    "api/socket.io.js": {
      "maxDuration": 300
    },
    "api/socket.io/[...path].js": {
      "maxDuration": 300
    }
  }
}
